<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.cpx.dangdang.dao.PayDao">

    <insert id="insertPay">
        insert into t_pay values(null,#{orderId},#{userId},#{amount},#{payMethod},#{payStatus},#{comeFrom},#{returnUrl},#{createTime})
    </insert>

    <update id="updateStatus">
        update t_pay set pay_status = 20 where order_id = #{orderId}
    </update>

</mapper>
