<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.cpx.dangdang.dao.UserDao">

    <select id="selectUserByEmailAndPassword" resultType="User">
        select * from t_user where email = #{email} and password = #{password} and status = 1
    </select>

    <insert id="insertUser">
        insert into t_user values(null,#{email},#{password},#{salt},#{nickname},0,#{code},now())
    </insert>

    <select id="selectUserByEmail" resultType="User">
        select * from t_user where email = #{email}
    </select>

    <update id="updateStatus">
        update t_user set status = 1 where email = #{email}
    </update>

</mapper>
