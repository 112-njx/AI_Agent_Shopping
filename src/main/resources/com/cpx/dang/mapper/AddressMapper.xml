<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.cpx.dangdang.dao.AddressDao">

    <select id="selectAllAddress" resultType="Address">
        select * from t_address where user_id = #{userId}
    </select>

    <select id="selectById" resultType="Address">
        select * from t_address where address_id = #{id}
    </select>

</mapper>
